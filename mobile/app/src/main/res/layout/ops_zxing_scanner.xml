<?xml version="1.0" encoding="utf-8"?>
<!--
    File:        ops_zxing_scanner.xml
    Component:   Booking Views & Grid Operator Verification
    Description: Custom inner layout for ZXing Android Embedded's DecoratedBarcodeView
                 (Apache 2.0, https://github.com/journeyapps/zxing-android-embedded).
                 The three zxing_* ids are required by the library. Compared with the default
                 layout this hides the red laser and yellow result dots and adds a clean frame.
    Author:      Gunathilaka K.K.N.M.
-->
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <com.journeyapps.barcodescanner.BarcodeView
        android:id="@+id/zxing_barcode_surface"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:zxing_framing_rect_height="248dp"
        app:zxing_framing_rect_width="248dp"
        app:zxing_preview_scaling_strategy="centerCrop"
        app:zxing_use_texture_view="false" />

    <com.journeyapps.barcodescanner.ViewfinderView
        android:id="@+id/zxing_viewfinder_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:zxing_possible_result_points="@android:color/transparent"
        app:zxing_result_view="@color/ops_scanner_mask"
        app:zxing_viewfinder_laser_visibility="false"
        app:zxing_viewfinder_mask="@color/ops_scanner_mask" />

    <!-- Frame drawn just outside the 248dp scanning area -->
    <View
        android:layout_width="256dp"
        android:layout_height="256dp"
        android:layout_gravity="center"
        android:background="@drawable/bg_ops_scan_frame" />

    <TextView
        android:id="@+id/zxing_status_view"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone" />
</merge>
