<?xml version="1.0" encoding="utf-8"?>
<!--
    File:        sheet_manual_code.xml
    Component:   Booking Views & Grid Operator Verification
    Description: Bottom sheet for typing or pasting a booking code when the camera can't be used.
    Author:      Gunathilaka K.K.N.M.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingHorizontal="24dp"
    android:paddingTop="8dp"
    android:paddingBottom="24dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/ops_manual_title"
        android:textAppearance="?attr/textAppearanceTitleLarge"
        android:textColor="@color/text_primary" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="@string/ops_manual_message"
        android:textAppearance="@style/TextAppearance.Ops.Caption"
        android:textSize="14sp" />

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/tilManualCode"
        style="@style/Widget.Ops.TextInput"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:hint="@string/ops_manual_hint"
        app:endIconMode="clear_text"
        app:helperText="@string/ops_manual_helper"
        app:startIconDrawable="@drawable/ic_ops_key">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etManualCode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:imeOptions="actionGo"
            android:importantForAutofill="no"
            android:inputType="textNoSuggestions|textVisiblePassword"
            android:maxLength="300"
            android:maxLines="1" />
    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnManualVerify"
        style="@style/Widget.Ops.Button"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/ops_manual_verify"
        app:icon="@drawable/ic_ops_verified" />
</LinearLayout>
