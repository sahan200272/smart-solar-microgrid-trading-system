<?xml version="1.0" encoding="utf-8"?>
<!--
    File:        activity_transfer_receipt.xml
    Component:   Booking Views & Grid Operator Verification
    Description: Summary shown after an energy transfer is finalised.
    Author:      Gunathilaka K.K.N.M.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/receiptRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/card_bg"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        style="@style/Widget.Ops.Toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        app:navigationContentDescription="@string/ops_action_close"
        app:navigationIcon="@drawable/ic_ops_close"
        app:title="@string/ops_receipt_title" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/border_light" />

    <androidx.core.widget.NestedScrollView
        android:defaultFocusHighlightEnabled="false"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@color/bg_light"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/ops_form_padding"
            android:paddingTop="16dp"
            android:paddingBottom="24dp">

            <include
                android:id="@+id/stepper"
                layout="@layout/layout_ops_stepper" />

            <FrameLayout
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:layout_marginTop="28dp"
                android:background="@drawable/bg_ops_circle_tint"
                android:backgroundTint="@color/ops_approved_bg">

                <ImageView
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_gravity="center"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_check_circle"
                    app:tint="@color/ops_approved" />
            </FrameLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:accessibilityLiveRegion="polite"
                android:gravity="center"
                android:text="@string/ops_receipt_heading"
                android:textAppearance="?attr/textAppearanceHeadlineSmall"
                android:textColor="@color/text_primary" />

            <TextView
                android:id="@+id/tvReceiptSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center"
                android:textAppearance="@style/TextAppearance.Ops.Caption"
                android:textSize="14sp"
                tools:text="Completed at 10:42 AM · this QR code can no longer be used" />

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.Ops.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="16dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/ops_receipt_card_title"
                            android:textAppearance="@style/TextAppearance.Ops.SectionTitle" />

                        <TextView
                            android:id="@+id/tvReceiptStatus"
                            style="@style/Widget.Ops.Badge"
                            tools:text="Completed" />
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/border_light" />

                    <LinearLayout
                        android:id="@+id/receiptRows"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:divider="@drawable/ops_divider_horizontal"
                        android:orientation="vertical"
                        android:paddingHorizontal="16dp"
                        android:paddingBottom="4dp"
                        android:showDividers="middle" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_ops_bottom_bar"
        android:orientation="horizontal"
        android:paddingHorizontal="@dimen/ops_form_padding"
        android:paddingTop="13dp"
        android:paddingBottom="12dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnBackToConsole"
            style="@style/Widget.Ops.Button.Outlined"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="12dp"
            android:layout_weight="1"
            android:text="@string/ops_action_back_to_console" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnScanNext"
            style="@style/Widget.Ops.Button"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/ops_action_scan_next"
            app:icon="@drawable/ic_qr" />
    </LinearLayout>
</LinearLayout>
