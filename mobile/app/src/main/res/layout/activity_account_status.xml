<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/bg_light">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="16dp">

            <ImageButton
                android:id="@+id/btnBack"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_arrow_back"
                android:contentDescription="Back" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:text="Account Status"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary" />

            <ImageButton
                android:id="@+id/btnRefresh"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_solar_power"
                android:contentDescription="Refresh" />
        </LinearLayout>

        <!-- Progress Loading -->
        <ProgressBar
            android:id="@+id/progressBar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginVertical="12dp"
            android:visibility="gone" />

        <!-- Error Message Banner -->
        <TextView
            android:id="@+id/tvErrorMessage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:background="@drawable/bg_banner_error"
            android:textColor="@color/error_red"
            android:textSize="13sp"
            android:visibility="gone" />

        <!-- Status Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="2dp"
            app:strokeWidth="1dp"
            app:strokeColor="@color/border_light"
            app:cardBackgroundColor="@color/card_bg">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center_horizontal"
                android:padding="24dp">

                <ImageView
                    android:id="@+id/ivStatusIcon"
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:src="@drawable/ic_check_circle"
                    android:contentDescription="Status Icon" />

                <TextView
                    android:id="@+id/tvStatusTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Account Status: ACTIVE"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="@color/status_active"
                    tools:text="Account Status: ACTIVE" />

                <TextView
                    android:id="@+id/tvUserNic"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textSize="13sp"
                    android:textColor="@color/text_secondary"
                    tools:text="NIC: 200012345678" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/border_light"
                    android:layout_marginVertical="16dp" />

                <TextView
                    android:id="@+id/tvStatusDescription"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="14sp"
                    android:textColor="@color/text_secondary"
                    android:lineSpacingExtra="4dp"
                    android:text="Your account is active and verified. You have full access to microgrid trading and node features." />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Policy Card (Explaining No Self-Reactivation) -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="14dp"
            app:cardElevation="1dp"
            app:strokeWidth="1dp"
            app:strokeColor="@color/border_light"
            app:cardBackgroundColor="@color/card_bg">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Microgrid Security Policy"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:textSize="13sp"
                    android:textColor="@color/text_secondary"
                    android:lineSpacingExtra="3dp"
                    android:text="• Pending accounts must be activated by Backoffice administrators before access is granted.\n• If an account is deactivated, self-reactivation is strictly forbidden to preserve grid integrity.\n• Account reactivation can only be performed by Backoffice administrators." />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Deactivation Request Section (Card) -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardDeactivate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="1dp"
            app:strokeWidth="1dp"
            app:strokeColor="@color/error_red"
            app:cardBackgroundColor="@color/card_bg">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Request Account Deactivation"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="@color/error_red" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:layout_marginBottom="14dp"
                    android:textSize="13sp"
                    android:textColor="@color/text_secondary"
                    android:text="Deactivating your account will immediately revoke access to battery slot reservations and energy trading. You will not be able to reactivate your account yourself." />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnDeactivate"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:text="Deactivate My Account"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    app:cornerRadius="10dp"
                    android:backgroundTint="@color/error_red" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Return to Dashboard Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnGoDashboard"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:text="Go to Dashboard"
            android:textSize="15sp"
            app:cornerRadius="10dp"
            android:backgroundTint="@color/primary"
            android:layout_marginBottom="10dp" />

        <!-- Logout Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnLogout"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="Logout"
            android:textColor="@color/error_red"
            app:strokeColor="@color/error_red"
            app:cornerRadius="10dp"
            app:icon="@drawable/ic_logout"
            app:iconTint="@color/error_red"
            android:layout_marginBottom="24dp" />

    </LinearLayout>
</ScrollView>
