<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_light">

    <!-- Top App Bar / Toolbar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp"
        android:background="@color/card_bg"
        android:elevation="2dp">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_arrow_back"
            app:tint="@color/text_primary"
            android:contentDescription="Back" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="8dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Prosumer Profile"
                android:textSize="17sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary" />

            <TextView
                android:id="@+id/tvToolbarSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Grid Operator Inspection"
                android:textSize="11sp"
                android:textColor="@color/text_muted" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/btnRefresh"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_refresh"
            app:tint="@color/primary"
            android:contentDescription="Refresh" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- Scrollable Details Content -->
        <ScrollView
            android:id="@+id/scrollDetails"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <!-- Header Card: Avatar, Full Name, NIC, and Status Badge -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="2dp"
                    app:strokeWidth="1dp"
                    app:strokeColor="@color/border_light"
                    app:cardBackgroundColor="@color/card_bg">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="20dp"
                        android:gravity="center_horizontal">

                        <!-- Avatar Circle -->
                        <FrameLayout
                            android:layout_width="64dp"
                            android:layout_height="64dp"
                            android:background="@drawable/bg_card_rounded"
                            android:backgroundTint="#EFF6FF">

                            <ImageView
                                android:layout_width="36dp"
                                android:layout_height="36dp"
                                android:layout_gravity="center"
                                android:src="@drawable/ic_person"
                                app:tint="#2563EB"
                                android:contentDescription="Avatar" />
                        </FrameLayout>

                        <TextView
                            android:id="@+id/tvDetailFullName"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Loading Name..."
                            android:textSize="20sp"
                            android:textStyle="bold"
                            android:textColor="@color/text_primary"
                            android:layout_marginTop="12dp"
                            android:textAlignment="center" />

                        <TextView
                            android:id="@+id/tvDetailNic"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="NIC: --"
                            android:textSize="13sp"
                            android:textColor="@color/text_muted"
                            android:layout_marginTop="2dp" />

                        <!-- Status Badge -->
                        <TextView
                            android:id="@+id/tvDetailStatusBadge"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="● Active"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:background="@drawable/bg_status_active"
                            android:textColor="@color/status_active"
                            android:paddingStart="14dp"
                            android:paddingTop="6dp"
                            android:paddingEnd="14dp"
                            android:paddingBottom="6dp"
                            android:layout_marginTop="12dp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Status & Backoffice Authority Notice Card (CRITICAL REQUIREMENT) -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardAuthorityNotice"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    app:cardCornerRadius="14dp"
                    app:cardElevation="0dp"
                    app:strokeWidth="1dp"
                    app:strokeColor="#BAE6FD"
                    app:cardBackgroundColor="#F0F9FF">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:padding="16dp"
                        android:gravity="top">

                        <ImageView
                            android:id="@+id/ivNoticeIcon"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@drawable/ic_check_circle"
                            app:tint="#0284C7"
                            android:contentDescription="Notice Icon"
                            android:layout_marginTop="1dp" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:layout_marginStart="12dp">

                            <TextView
                                android:id="@+id/tvNoticeTitle"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Account Verification Notice"
                                android:textSize="13sp"
                                android:textStyle="bold"
                                android:textColor="#0369A1" />

                            <TextView
                                android:id="@+id/tvNoticeMessage"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Notice message goes here."
                                android:textSize="12sp"
                                android:textColor="#0C4A6E"
                                android:lineSpacingExtra="3dp"
                                android:layout_marginTop="4dp" />
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Prosumer Information Card -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    app:cardCornerRadius="14dp"
                    app:cardElevation="1dp"
                    app:strokeWidth="1dp"
                    app:strokeColor="@color/border_light"
                    app:cardBackgroundColor="@color/card_bg">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="18dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="PROSUMER INFORMATION"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:textColor="@color/text_muted"
                            android:letterSpacing="0.08"
                            android:layout_marginBottom="14dp" />

                        <!-- Row: NIC -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:layout_marginBottom="14dp">

                            <ImageView
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:src="@drawable/ic_badge_id"
                                app:tint="@color/text_muted"
                                android:contentDescription="NIC" />

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical"
                                android:layout_marginStart="12dp">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="National Identity Card (NIC)"
                                    android:textSize="11sp"
                                    android:textColor="@color/text_muted" />

                                <TextView
                                    android:id="@+id/tvInfoNic"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="--"
                                    android:textSize="14sp"
                                    android:textStyle="bold"
                                    android:textColor="@color/text_primary"
                                    android:layout_marginTop="1dp" />
                            </LinearLayout>
                        </LinearLayout>

                        <!-- Row: Phone -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:layout_marginBottom="14dp">

                            <ImageView
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:src="@drawable/ic_phone"
                                app:tint="@color/text_muted"
                                android:contentDescription="Phone" />

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical"
                                android:layout_marginStart="12dp">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Contact Phone"
                                    android:textSize="11sp"
                                    android:textColor="@color/text_muted" />

                                <TextView
                                    android:id="@+id/tvInfoPhone"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="--"
                                    android:textSize="14sp"
                                    android:textColor="@color/text_primary"
                                    android:layout_marginTop="1dp" />
                            </LinearLayout>
                        </LinearLayout>

                        <!-- Row: Email -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:layout_marginBottom="14dp">

                            <ImageView
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:src="@drawable/ic_email"
                                app:tint="@color/text_muted"
                                android:contentDescription="Email" />

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical"
                                android:layout_marginStart="12dp">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Email Address"
                                    android:textSize="11sp"
                                    android:textColor="@color/text_muted" />

                                <TextView
                                    android:id="@+id/tvInfoEmail"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="--"
                                    android:textSize="14sp"
                                    android:textColor="@color/text_primary"
                                    android:layout_marginTop="1dp" />
                            </LinearLayout>
                        </LinearLayout>

                        <!-- Row: Address -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:layout_marginBottom="14dp">

                            <ImageView
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:src="@drawable/ic_home"
                                app:tint="@color/text_muted"
                                android:contentDescription="Address" />

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical"
                                android:layout_marginStart="12dp">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Residential / Microgrid Location"
                                    android:textSize="11sp"
                                    android:textColor="@color/text_muted" />

                                <TextView
                                    android:id="@+id/tvInfoAddress"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="--"
                                    android:textSize="14sp"
                                    android:textColor="@color/text_primary"
                                    android:layout_marginTop="1dp" />
                            </LinearLayout>
                        </LinearLayout>

                        <!-- Row: Account ID -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:layout_marginBottom="14dp">

                            <ImageView
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:src="@drawable/ic_lock"
                                app:tint="@color/text_muted"
                                android:contentDescription="Account ID" />

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical"
                                android:layout_marginStart="12dp">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="System User ID"
                                    android:textSize="11sp"
                                    android:textColor="@color/text_muted" />

                                <TextView
                                    android:id="@+id/tvInfoId"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="--"
                                    android:textSize="12sp"
                                    android:textColor="@color/text_secondary"
                                    android:layout_marginTop="1dp" />
                            </LinearLayout>
                        </LinearLayout>

                        <!-- Row: Created At -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <ImageView
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:src="@drawable/ic_calendar"
                                app:tint="@color/text_muted"
                                android:contentDescription="Created At" />

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical"
                                android:layout_marginStart="12dp">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Account Registered On"
                                    android:textSize="11sp"
                                    android:textColor="@color/text_muted" />

                                <TextView
                                    android:id="@+id/tvInfoCreatedAt"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="--"
                                    android:textSize="13sp"
                                    android:textColor="@color/text_primary"
                                    android:layout_marginTop="1dp" />
                            </LinearLayout>
                        </LinearLayout>

                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Operational Shortcut: View Bookings for this Prosumer -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnViewBookings"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:text="View Prosumer Bookings"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    app:cornerRadius="12dp"
                    app:icon="@drawable/ic_calendar"
                    app:iconGravity="textStart"
                    android:textColor="@color/primary"
                    app:strokeColor="@color/primary"
                    app:strokeWidth="1dp"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton" />

                <!-- Bottom informational disclaimer: strictly read-only -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Grid Operator Terminal: Read-only profile view. Under system specifications, account activation and reactivation permissions are strictly restricted to the Backoffice web administration application."
                    android:textSize="11sp"
                    android:textColor="@color/text_muted"
                    android:gravity="center"
                    android:layout_marginTop="16dp"
                    android:layout_marginBottom="8dp" />

            </LinearLayout>
        </ScrollView>

        <!-- Loading View -->
        <LinearLayout
            android:id="@+id/layoutLoading"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:background="@color/bg_light"
            android:visibility="gone">

            <ProgressBar
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:indeterminateTint="@color/primary" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Loading prosumer details from API..."
                android:textSize="13sp"
                android:textColor="@color/text_secondary"
                android:layout_marginTop="12dp" />
        </LinearLayout>

        <!-- Error View -->
        <LinearLayout
            android:id="@+id/layoutError"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:background="@color/bg_light"
            android:padding="32dp"
            android:visibility="gone">

            <ImageView
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:src="@drawable/ic_warning"
                app:tint="@color/error_red"
                android:contentDescription="Error" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Could Not Load Details"
                android:textSize="17sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:layout_marginTop="16dp" />

            <TextView
                android:id="@+id/tvErrorMessage"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="An error occurred while fetching details."
                android:textSize="13sp"
                android:textColor="@color/text_secondary"
                android:gravity="center"
                android:layout_marginTop="6dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnRetry"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Try Again"
                android:layout_marginTop="16dp"
                app:cornerRadius="8dp" />
        </LinearLayout>

    </FrameLayout>
</LinearLayout>
